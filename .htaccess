# =============================================================================
#  Viovas — configurare Apache
#  Urcă acest fișier în rădăcina site-ului, alături de index.html.
#  Dacă hostingul tău nu e Apache (Nginx, Netlify, Vercel), vezi _redirects.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. Redirecționări 301 de la vechile adrese WordPress către noile pagini.
#     Fără acestea pierzi poziționarea în Google pentru paginile existente.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^despre-noi/?$                  /despre.html                      [R=301,L]
  RewriteRule ^categorii/?$                   /categorii.html                   [R=301,L]
  RewriteRule ^contact/?$                     /contact.html                     [R=301,L]
  RewriteRule ^politica-confidentialitate/?$  /politica-confidentialitate.html  [R=301,L]
  RewriteRule ^politica-de-cookies/?$         /politica-de-cookies.html         [R=301,L]

  # Resturi din instalarea WordPress
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json)  /  [R=301,L]
  RewriteRule ^author/.*$                     /                                 [R=301,L]
  RewriteRule ^feed/?$                        /                                 [R=301,L]

  # Forțează HTTPS și www
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.viovas.ro/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^viovas\.ro$ [NC]
  RewriteRule ^(.*)$ https://www.viovas.ro/$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
#  2. Compresie
# -----------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json application/rss+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json application/rss+xml
  AddOutputFilterByType DEFLATE font/woff2 font/ttf image/x-icon
</IfModule>

# Fallback pentru servere fără mod_filter modern
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_item_include mime ^text/.*
  mod_gzip_item_include mime ^application/(javascript|json|xml|manifest\+json)$
</IfModule>

# -----------------------------------------------------------------------------
#  3. Cache. HTML scurt (ca modificările să se vadă imediat),
#     restul pe termen lung.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------------
#  4. Securitate de bază
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://api.web3forms.com; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://www.google.com; child-src https://www.google.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.web3forms.com; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

Options -Indexes

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
